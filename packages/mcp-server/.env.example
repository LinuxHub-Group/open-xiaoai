# 音箱 Rust Client 主动连接到此 WebSocket 地址；生产部署应绑定受控网卡。
DEVICE_WS_HOST=0.0.0.0

# 音箱 Rust Client 的反向 WebSocket 端口。
DEVICE_WS_PORT=4399

# 可选。验证音箱连接；Client 使用 ?token=<值> 或 Authorization: Bearer <值>。
# DEVICE_TOKEN=change-this-device-token

# MCP HTTP 服务监听地址。仅本机 Agent 使用时保持 loopback。
MCP_HOST=127.0.0.1

# MCP HTTP 服务监听端口。
MCP_PORT=8080

# 可选。MCP HTTP Bearer 令牌；当 MCP_HOST 不是 loopback 时必须设置。
# MCP_AUTH_TOKEN=change-this-mcp-token
